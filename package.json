    "perf": "node scripts/perf.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "node scripts/build-app.mjs",
    "release": "node scripts/release.mjs",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
