{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenViewer",
  "version": "0.1.0",
  "identifier": "app.openviewer.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenViewer",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}