{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "documents",
  "description": "Document windows and their user-selected files",
  "windows": ["main", "document-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:allow-open-url",
    "allow-read-document",
    "allow-write-document",
    "allow-create-document-window",
    "allow-frontend-ready",
    "allow-sync-view-menu",
    "allow-open-dialog",
    "allow-save-dialog",
    "allow-resolve-image-path",
    "allow-get-keybindings"
  ]
}
