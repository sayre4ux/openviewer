{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:allow-open-url",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title"
  ]
}